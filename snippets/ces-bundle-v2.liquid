{%- comment -%}
  ces-bundle-v2 — subscribe-and-save style tier selector.

  Same contract as ces-bundle (it reuses <ces-bundle> and ces-bundle.js, so the
  radios, free-item variants, add-to-cart and cart drawer all behave the same).
  What differs is presentation: only the selected tier expands to show its
  benefit checklist, free-gift strip and fine print.

  Accepts: block (the ces_bundle_v2 block).
{%- endcomment -%}

{%- liquid
  assign ces_accent = block.settings.accent_color | default: '#1D5C5C'
  assign ces_accent_r = ces_accent | color_extract: 'red'
  assign ces_accent_g = ces_accent | color_extract: 'green'
  assign ces_accent_b = ces_accent | color_extract: 'blue'
  assign ces_tier_count = block.settings.tier_count | default: 3
  assign ces_default_tier = block.settings.default_tier | default: 1
-%}

<ces-bundle
  id="ces-bundle"
  class="ces-b2 ces-b2--{{ block.settings.tier_style | default: 'stacked' }}{% if block.settings.purchase_type == 'choice' %} ces-b2--choice{% if block.settings.subscribe_default %} ces-b2--subscribed{% endif %}{% endif %} quick-add-hidden"
  style="--ces-b2-accent: {{ ces_accent }}; --ces-b2-accent-rgb: {{ ces_accent_r }}, {{ ces_accent_g }}, {{ ces_accent_b }}; --ces-bundle-accent: {{ ces_accent }}; --ces-b2-tint: {% if block.settings.selected_bg != blank %}{{ block.settings.selected_bg }}{% else %}{{ ces_accent }}12{% endif %}; scroll-margin-top: 9rem;"
  data-open-drawer="{{ block.settings.open_cart_drawer | default: true }}"
  data-after-add="{{ block.settings.after_add | default: 'drawer' }}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.label != blank -%}
    <p class="ces-b2__label">{{ block.settings.label }}</p>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    <p class="ces-b2__heading">{{ block.settings.heading }}</p>
  {%- endif -%}
  {%- if block.settings.intro != blank -%}
    <p class="ces-b2__intro">{{ block.settings.intro }}</p>
  {%- endif -%}

  <div class="ces-b2__tiers" role="radiogroup" aria-label="{{ block.settings.label | default: 'Choose your plan' | escape }}">
    {%- for ces_i in (1..ces_tier_count) -%}
      {%- liquid
        assign vkey = 'tier_' | append: ces_i | append: '_variant'
        assign ces_key = block.settings[vkey] | strip
        assign ces_key_dc = ces_key | downcase
        assign ces_v = null

        comment
          Resolve the tier's variant: exact title, then position (1, 2, 3...),
          then a substring of the title, then variant id.
        endcomment
        for v in product.variants
          assign vt = v.title | downcase
          if vt == ces_key_dc and ces_v == null
            assign ces_v = v
          endif
        endfor
        # Tried before the substring pass: a key of "2" means position 2, but it
        # is also a substring of a variant titled "6 Packs (12 Patches)", so a
        # substring pass running first resolves it to the wrong variant. A
        # variant id is far larger than the variant count, so ids fall through.
        if ces_v == null
          assign ces_pos = ces_key | times: 1
          if ces_pos > 0 and ces_pos <= product.variants.size
            assign ces_idx = ces_pos | minus: 1
            assign ces_v = product.variants[ces_idx]
          endif
        endif
        if ces_v == null
          for v in product.variants
            assign vt = v.title | downcase
            # Every string contains the empty string, so without this guard an
            # unset variant key would resolve every tier to the first variant.
            if ces_key_dc != blank and vt contains ces_key_dc and ces_v == null
              assign ces_v = v
            endif
          endfor
        endif
        if ces_v == null
          assign ces_vid_num = ces_key | times: 1
          for v in product.variants
            if v.id == ces_vid_num and ces_v == null
              assign ces_v = v
            endif
          endfor
        endif
      -%}

      {%- if ces_v != null -%}
        {%- liquid
          assign imkey = 'tier_' | append: ces_i | append: '_image'
        assign nkey  = 'tier_' | append: ces_i | append: '_name'
          assign bkey  = 'tier_' | append: ces_i | append: '_badge'
          assign stkey = 'tier_' | append: ces_i | append: '_subtitle'
          assign mtkey = 'tier_' | append: ces_i | append: '_meta'
          assign tnkey = 'tier_' | append: ces_i | append: '_treatments'
          assign qtkey = 'tier_' | append: ces_i | append: '_quote'
          assign rlkey = 'tier_' | append: ces_i | append: '_role'
          assign pkey  = 'tier_' | append: ces_i | append: '_price'
          assign ukey  = 'tier_' | append: ces_i | append: '_unit'
          assign ckey  = 'tier_' | append: ces_i | append: '_compare'
          assign okey  = 'tier_' | append: ces_i | append: '_off'
          assign srkey = 'tier_' | append: ces_i | append: '_serving'
          assign fkey  = 'tier_' | append: ces_i | append: '_fine'
          assign nbkey = 'tier_' | append: ces_i | append: '_benefits'
          assign gtkey = 'tier_' | append: ces_i | append: '_gift_title'
          assign gskey = 'tier_' | append: ces_i | append: '_gift_sub'
          assign glkey = 'tier_' | append: ces_i | append: '_gift_label'
          assign ftkey = 'tier_' | append: ces_i | append: '_foot'
          assign ctakey = 'tier_' | append: ces_i | append: '_cta'
          assign frkey = 'tier_' | append: ces_i | append: '_free_products'

          comment
            What the shopper pays for this tier. In subscription mode the
            variant's first selling plan is added with the line, so its price
            is the one to show; a variant without a plan falls back to one-time.
          endcomment
          assign ces_plan_id = ''
          assign ces_alloc = null
          assign ces_pay = ces_v.price
          assign ces_was = ces_v.compare_at_price | default: 0
          assign ces_mode = block.settings.purchase_type | default: 'onetime'
          if ces_mode == 'subscription' or ces_mode == 'choice'
            comment
              The tier's plan field names a selling plan by id or by part of
              its name; blank, or no match, takes the variant's first plan.
            endcomment
            assign plkey = 'tier_' | append: ces_i | append: '_plan'
            assign ces_plan_key = block.settings[plkey] | strip | downcase
            assign ces_alloc = null
            if ces_plan_key != blank
              assign ces_plan_num = ces_plan_key | times: 1
              for a in ces_v.selling_plan_allocations
                assign ces_plan_name = a.selling_plan.name | downcase
                if ces_alloc == null
                  if a.selling_plan.id == ces_plan_num or ces_plan_name contains ces_plan_key
                    assign ces_alloc = a
                  endif
                endif
              endfor
            endif
            if ces_alloc == null
              assign ces_alloc = ces_v.selling_plan_allocations | first
            endif
            if ces_alloc and ces_mode == 'subscription'
              assign ces_plan_id = ces_alloc.selling_plan.id
              assign ces_pay = ces_alloc.price
              assign ces_alloc_was = ces_alloc.compare_at_price | default: 0
              if ces_alloc_was > ces_was
                assign ces_was = ces_alloc_was
              endif
            endif
          endif

          assign rfkey = 'tier_' | append: ces_i | append: '_refill'
          assign ces_refill = block.settings[rfkey]
          if ces_refill == blank and ces_alloc
            assign ces_refill = ces_alloc.selling_plan.name
          endif
          if ces_checked_refill == null and ces_i == ces_default_tier
            assign ces_checked_refill = ces_refill
          endif

          if block.settings[pkey] != blank
            assign ces_price = block.settings[pkey]
          else
            assign ces_price = ces_pay | money
          endif

          comment
            Auto compare: the struck-through price and the [save] amount come
            from the variant's compare-at price, so they follow each market's
            currency. A tier's own compare text still wins.
          endcomment
          assign ces_compare = block.settings[ckey]
          assign ces_save = ''
          if block.settings.auto_compare and ces_was > ces_pay
            if ces_compare == blank
              assign ces_compare = ces_was | money
            endif
            assign ces_save = ces_was | minus: ces_pay | money
          endif
          comment
            Customer-chooses mode: the tier also carries its subscription
            price. The struck-through price there is the higher of the one-time
            price and, with auto compare on, the variant's compare-at price.
          endcomment
          assign ces_sub_plan_id = ''
          assign ces_sub_price = ''
          assign ces_sub_compare = ''
          assign ces_sub_save = ''
          assign ces_plan_label = ''
          if ces_mode == 'choice' and ces_alloc
            assign ces_sub_plan_id = ces_alloc.selling_plan.id
            assign ces_plan_label = ces_alloc.selling_plan.name
            assign ces_sub_pay = ces_alloc.price
            assign ces_sub_was = ces_alloc.compare_at_price | default: 0
            if ces_v.price > ces_sub_was
              assign ces_sub_was = ces_v.price
            endif
            if block.settings.auto_compare and ces_v.compare_at_price > ces_sub_was
              assign ces_sub_was = ces_v.compare_at_price
            endif
            assign ces_sub_price = ces_sub_pay | money
            if ces_sub_was > ces_sub_pay
              assign ces_sub_compare = ces_sub_was | money
              assign ces_sub_save = ces_sub_was | minus: ces_sub_pay | money
            endif
          endif
          if ces_checked_plan_label == null and ces_i == ces_default_tier
            assign ces_checked_plan_label = ces_plan_label
          endif

          comment
            A subtitle is read as " | " separated parts; a part holding [save]
            is dropped when there is no saving, so "You Save [save] | FREE
            Shipping" reads "FREE Shipping" rather than "You Save  | ...".
          endcomment
          assign ces_sub_parts = block.settings[stkey] | split: ' | '
          assign ces_subtitle = ''
          assign ces_subtitle_sub = ''
          for raw_part in ces_sub_parts
            assign part = raw_part | strip
            comment
              In customer-chooses mode the saving belongs to the subscribe
              state only; the one-time state keeps just the struck price.
            endcomment
            assign ces_drop_once = false
            if part contains '[save]'
              if ces_save == blank or ces_sub_plan_id != blank
                assign ces_drop_once = true
              endif
            endif
            unless ces_drop_once
              if ces_subtitle != blank
                assign ces_subtitle = ces_subtitle | append: ' | '
              endif
              assign ces_subtitle = ces_subtitle | append: part
            endunless
            unless part contains '[save]' and ces_sub_save == blank
              if ces_subtitle_sub != blank
                assign ces_subtitle_sub = ces_subtitle_sub | append: ' | '
              endif
              assign ces_subtitle_sub = ces_subtitle_sub | append: part
            endunless
          endfor
          assign ces_subtitle = ces_subtitle | replace: '[save]', ces_save
          assign ces_subtitle_sub = ces_subtitle_sub | replace: '[save]', ces_sub_save

          comment
            A tier's button can carry its own price with [price], so the label
            cannot fall out of step with what the shopper is about to pay.
          endcomment
          assign ces_cta_label = block.settings[ctakey] | replace: '[price]', ces_price

          assign ces_checked = false
          if ces_i == ces_default_tier
            assign ces_checked = true
          endif

          assign ces_free_ids = ''
          assign ces_free_list = block.settings[frkey]
          for fp in ces_free_list
            if fp.first_available_variant
              assign ces_free_ids = ces_free_ids | append: fp.first_available_variant.id | append: ','
            endif
          endfor

          comment
            The per-treatment figure is divided out of the variant's own price,
            so it follows Shopify's presentment currency for each market and
            cannot drift from what the customer is actually charged.
          endcomment
          assign ces_meta = block.settings[mtkey]
          assign ces_treatments = block.settings[tnkey] | default: 0
          if ces_treatments > 0
            assign ces_unit_cents = ces_pay | times: 1.0 | divided_by: ces_treatments | round
            assign ces_unit = ces_unit_cents | money
            assign ces_meta = block.settings.meta_template | default: '[count] treatments &middot; [unit]/treatment'
            assign ces_meta = ces_meta | replace: '[count]', ces_treatments | replace: '[unit]', ces_unit | replace: '[total]', ces_price
          endif

          comment
            Perks that are not products — express shipping, a warranty — cannot
            come from the product picker, since that also drives what the cart
            receives. They are listed separately and are display only.
            One per line: icon | name | value in the store's currency.
          endcomment
          assign ces_extra_rows = ''
          assign ces_extra_cents = 0
          assign xkey = 'tier_' | append: ces_i | append: '_extra_gifts'
          if block.settings[xkey] != blank
            assign ces_extra_rows = block.settings[xkey] | newline_to_br | split: '<br />'
            for xrow in ces_extra_rows
              assign xparts = xrow | split: '|'
              assign xamount = xparts[2] | strip | times: 100 | round
              assign ces_extra_cents = ces_extra_cents | plus: xamount
            endfor
          endif

          comment
            The gift value line is either typed in, or added up from the gift
            products and rounded to the nearest whole unit ($79.90 reads $80).
          endcomment
          assign ces_gift_sub = block.settings[gskey]
          if block.settings.gift_sub_mode == 'auto'
            assign ces_gift_cents = ces_extra_cents
            for fp in ces_free_list limit: 3
              assign ces_gift_cents = ces_gift_cents | plus: fp.price
            endfor
            assign ces_gift_cents = ces_gift_cents | plus: 50 | divided_by: 100 | times: 100
            if ces_gift_cents > 0
              assign ces_gift_value = ces_gift_cents | money_without_trailing_zeros
              assign ces_gift_count = ces_free_list.size | at_most: 3 | plus: ces_extra_rows.size
              assign ces_gift_word = 'items'
              if ces_gift_count == 1
                assign ces_gift_word = 'item'
              endif
              assign ces_gift_sub = block.settings.gift_sub_template | default: '[value] value &middot; [count] [items]'
              assign ces_gift_sub = ces_gift_sub | replace: '[value]', ces_gift_value | replace: '[count]', ces_gift_count | replace: '[items]', ces_gift_word
            endif
          endif
        -%}

        <label class="ces-b2__tier ces-bundle__tier{% if block.settings[bkey] != blank %} ces-b2__tier--badged{% endif %}{% if ces_checked %} is-selected{% endif %}{% unless ces_v.available %} is-unavailable{% endunless %}">
          {%- if block.settings[bkey] != blank -%}
            <span class="ces-b2__ribbon">{{ block.settings[bkey] }}</span>
          {%- endif -%}

          <span class="ces-b2__head">
            <input
              type="radio"
              name="ces-bundle-{{ block.id }}"
              class="ces-bundle__radio visually-hidden"
              value="{{ ces_v.id }}"
              data-variant-id="{{ ces_v.id }}"
              data-quantity="1"
              data-free-ids="{{ ces_free_ids | strip }}"
              data-price-label="{{ ces_pay | money_with_currency | strip }}"
              {% if ces_plan_id != blank %}data-selling-plan="{{ ces_plan_id }}"{% endif %}
              {% if ces_sub_plan_id != blank %}data-selling-plan-sub="{{ ces_sub_plan_id }}" data-price-label-sub="{{ ces_sub_pay | money_with_currency | strip }}"{% endif %}
              data-plan-label="{{ ces_plan_label | escape }}"
              data-add-label="{{ ces_cta_label | escape }}"
              data-refill="{{ ces_refill | escape }}"
              {% unless ces_v.available %}data-unavailable="true"{% endunless %}
              {% if ces_checked %}checked{% endif %}
            >
            <span class="ces-b2__dot" aria-hidden="true"></span>

            {%- if block.settings.show_variant_image -%}
              {%- liquid
                # The tier's own picture wins; otherwise the variant's, and the
                # product's as a last resort, so a tier is never left with a hole
                # where the others have a thumbnail.
                assign ces_tier_img = block.settings[imkey]
                if ces_tier_img == blank
                  assign ces_tier_img = ces_v.featured_image | default: product.featured_image
                endif
              -%}
              {%- if ces_tier_img != blank -%}
                <span class="ces-b2__thumb-variant">
                  <img src="{{ ces_tier_img | image_url: width: 120 }}" alt="" loading="lazy" width="40" height="40">
                </span>
              {%- endif -%}
            {%- endif -%}

            <span class="ces-b2__titles">
              <span class="ces-b2__name">{{ block.settings[nkey] | default: ces_v.title }}</span>
              {%- if ces_sub_plan_id != blank -%}
                {%- if ces_subtitle != blank -%}<span class="ces-b2__subtitle ces-b2__v ces-b2__v--once">{{ ces_subtitle }}</span>{%- endif -%}
                {%- if ces_subtitle_sub != blank -%}<span class="ces-b2__subtitle ces-b2__v ces-b2__v--sub">{{ ces_subtitle_sub }}</span>{%- endif -%}
              {%- elsif ces_subtitle != blank -%}
                <span class="ces-b2__subtitle">{{ ces_subtitle }}</span>
              {%- endif -%}
            </span>
          </span>

          {%- comment -%}
            Subscription mode with no plan on this variant silently sells it
            one-time, so say so where only the merchant sees it.
          {%- endcomment -%}
          {%- if request.design_mode and ces_mode == 'subscription' and ces_plan_id == blank or request.design_mode and ces_mode == 'choice' and ces_sub_plan_id == blank -%}
            <span class="ces-b2__editor-warning">No subscription plan on this variant for the storefront, so this tier sells one-time. Check the plan is applied to this variant and that the store's payment provider supports subscriptions.</span>
          {%- endif -%}
          <span class="ces-b2__pricing">
            {%- if ces_sub_plan_id != blank -%}
              <span class="ces-b2__v ces-b2__v--once">
                <span class="ces-b2__price">{{ ces_price }}</span>
                {%- if ces_compare != blank -%}<span class="ces-b2__compare">{{ ces_compare }}</span>{%- endif -%}
              </span>
              <span class="ces-b2__v ces-b2__v--sub">
                <span class="ces-b2__price">{{ ces_sub_price }}</span>
                {%- if ces_sub_compare != blank -%}<span class="ces-b2__compare">{{ ces_sub_compare }}</span>{%- endif -%}
              </span>
            {%- else -%}
              <span class="ces-b2__price">{{ ces_price }}</span>
              {%- if ces_compare != blank -%}<span class="ces-b2__compare">{{ ces_compare }}</span>{%- endif -%}
            {%- endif -%}
            {%- if block.settings[ukey] != blank -%}<span class="ces-b2__unit">{{ block.settings[ukey] }}</span>{%- endif -%}
            {%- if block.settings[okey] != blank -%}<span class="ces-b2__off">{{ block.settings[okey] }}</span>{%- endif -%}
          </span>

          {%- comment -%}
            qtkey is historically named "quote"; it now carries the "Best for"
            line. The id is kept so existing theme settings are not orphaned.
          {%- endcomment -%}
          {%- if ces_meta != blank or block.settings[qtkey] != blank or block.settings[rlkey] != blank -%}
            <span class="ces-b2__ident">
              {%- if ces_meta != blank -%}
                <span class="ces-b2__meta">{{ ces_meta }}</span>
              {%- endif -%}
              {%- if block.settings[qtkey] != blank -%}
                <span class="ces-b2__bestfor">{{ block.settings[qtkey] }}</span>
              {%- endif -%}
              {%- if block.settings[rlkey] != blank -%}
                <span class="ces-b2__role">{{ block.settings[rlkey] }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}

          <span class="ces-b2__detail">
            {%- if block.settings[srkey] != blank -%}<span class="ces-b2__serving">{{ block.settings[srkey] }}</span>{%- endif -%}
            {%- if block.settings[fkey] != blank -%}<span class="ces-b2__fine">{{ block.settings[fkey] }}</span>{%- endif -%}

            {%- if block.settings[nbkey] != blank -%}
              <span class="ces-b2__benefits">
                {%- assign ces_bens = block.settings[nbkey] | newline_to_br | split: '<br />' -%}
                {%- for line in ces_bens -%}{%- assign l = line | strip -%}{%- if l != blank -%}
                  <span class="ces-b2__benefit">
                    <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M4 10.4 8 14.4l8-9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{{ l }}</span>
                  </span>
                {%- endif -%}{%- endfor -%}
              </span>
            {%- endif -%}


            {%- if block.settings[ftkey] != blank -%}<span class="ces-b2__foot">{{ block.settings[ftkey] }}</span>{%- endif -%}
          </span>
          {%- comment -%}
            The gift sits outside the detail block, which is hidden on a tier the
            shopper has not chosen. What comes free is part of the offer being
            compared, not a detail of the one already picked, so every tier shows
            it; only the opened-out list belongs to the chosen one.
          {%- endcomment -%}
          {%- if block.settings[gtkey] != blank and ces_free_list.size > 0 or block.settings[gtkey] != blank and ces_extra_rows.size > 0 -%}
            <span class="ces-b2__gift is-open" data-ces-gift>
              <button type="button" class="ces-b2__gift-bar" aria-expanded="true" data-ces-gift-toggle>
                <span class="ces-b2__gift-thumbs" aria-hidden="true">
                  {%- for fp in ces_free_list limit: 3 -%}
                    <span class="ces-b2__thumb">
                      {%- if fp.featured_image -%}
                        <img src="{{ fp.featured_image | image_url: width: 160 }}" alt="" loading="lazy">
                      {%- endif -%}
                      {%- if block.settings.show_gift_prices -%}
                        <span class="ces-b2__thumb-price">{{ fp.price | money }}</span>
                      {%- endif -%}
                    </span>
                  {%- endfor -%}
                  {%- for xrow in ces_extra_rows -%}
                    {%- assign xparts = xrow | split: '|' -%}
                    {%- assign xicon = xparts[0] | strip | downcase -%}
                    {%- if xparts[1] != blank -%}
                      <span class="ces-b2__thumb">
                        <span class="ces-b2__thumb-icon">{% render 'ces-bundle-icon', name: xicon %}</span>
                        {%- assign xcents = xparts[2] | strip | times: 100 | round -%}
                        {%- if xcents > 0 and block.settings.show_gift_prices -%}
                          <span class="ces-b2__thumb-price">{{ xcents | money_without_trailing_zeros }}</span>
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                </span>
                <span class="ces-b2__gift-text">
                  <span class="ces-b2__gift-title">{{ block.settings[gtkey] }}</span>
                  {%- if ces_gift_sub != blank -%}<span class="ces-b2__gift-sub">{{ ces_gift_sub }}</span>{%- endif -%}
                </span>
                <svg class="ces-b2__gift-chev" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="m5 12.5 5-5 5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {%- comment -%}
                  Always rendered: with no label the chevron alone still shows
                  the bar opens, and without it the block looks inert.
                {%- endcomment -%}
                <span class="ces-b2__gift-more">
                  {%- if block.settings.gift_more_label != blank -%}
                    <span>{{ block.settings.gift_more_label }}</span>
                  {%- endif -%}
                  <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>

              <span class="ces-b2__gift-panel" data-ces-gift-panel>
                {%- if block.settings[glkey] != blank -%}
                  <span class="ces-b2__gift-label">{{ block.settings[glkey] }}</span>
                {%- endif -%}
                <span class="ces-b2__gift-grid">
                  {%- for fp in ces_free_list limit: 3 -%}
                    <span class="ces-b2__gift-item">
                      {%- if fp.featured_image -%}
                        <img src="{{ fp.featured_image | image_url: width: 300 }}" alt="{{ fp.title | escape }}" loading="lazy">
                      {%- endif -%}
                      {%- if block.settings.show_gift_prices -%}
                        <span class="ces-b2__thumb-price">{{ fp.price | money }}</span>
                      {%- endif -%}
                      <span class="ces-b2__gift-name">{{ fp.title }}</span>
                    </span>
                  {%- endfor -%}
                  {%- for xrow in ces_extra_rows -%}
                    {%- assign xparts = xrow | split: '|' -%}
                    {%- assign xicon = xparts[0] | strip | downcase -%}
                    {%- if xparts[1] != blank -%}
                      <span class="ces-b2__gift-item">
                        <span class="ces-b2__gift-icon">{% render 'ces-bundle-icon', name: xicon %}</span>
                        {%- assign xcents = xparts[2] | strip | times: 100 | round -%}
                        {%- if xcents > 0 and block.settings.show_gift_prices -%}
                          <span class="ces-b2__thumb-price">{{ xcents | money_without_trailing_zeros }}</span>
                        {%- endif -%}
                        <span class="ces-b2__gift-name">{{ xparts[1] | strip }}</span>
                      </span>
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              </span>
            </span>
          {%- endif -%}
        </label>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%}
    Customer-chooses mode: one checkbox switches every tier between its
    one-time and its subscribe-and-save price, and decides whether the line is
    added with the tier's selling plan. [plan] is the selected tier's plan name.
  {%- endcomment -%}
  {%- if block.settings.purchase_type == 'choice' -%}
    <label class="ces-b2__subscribe">
      <input type="checkbox" class="ces-b2__subscribe-input visually-hidden" data-ces-subscribe {% if block.settings.subscribe_default %}checked{% endif %}>
      <span class="ces-b2__subscribe-box" aria-hidden="true"></span>
      <span class="ces-b2__subscribe-text">
        <span class="ces-b2__subscribe-title">{{ block.settings.subscribe_label | default: 'Subscribe & Save' }}</span>
        {%- if block.settings.subscribe_sub != blank -%}
          {%- capture ces_plan_span -%}<span data-ces-plan-label>{{ ces_checked_plan_label | escape }}</span>{%- endcapture -%}
          {%- capture ces_refill_span2 -%}<span data-ces-refill>{{ ces_checked_refill | escape }}</span>{%- endcapture -%}
          <span class="ces-b2__subscribe-sub">{{ block.settings.subscribe_sub | replace: '[plan]', ces_plan_span | replace: '[refill]', ces_refill_span2 }}</span>
        {%- endif -%}
      </span>
    </label>
  {%- endif -%}

  {%- capture ces_trust_row -%}
    {%- if block.settings.trust_line != blank -%}
      <p class="ces-b2__trust">{{ block.settings.trust_line }}</p>
    {%- endif -%}
  {%- endcapture -%}

  {%- unless block.settings.trust_position == 'below' -%}{{ ces_trust_row }}{%- endunless -%}

  {%- if block.settings.onetime_label != blank -%}
    <a class="ces-b2__onetime" href="{{ block.settings.onetime_url | default: '#' }}">{{ block.settings.onetime_label }}</a>
  {%- endif -%}

  <p class="ces-b2__error" data-ces-bundle-error hidden></p>

  {%- comment -%}
    Shipping-estimate row, same markup and classes as the V1 selector so the
    two pages read identically.
  {%- endcomment -%}
  {%- capture ces_ship_row -%}
    {%- if block.settings.show_shipping -%}
      {%- assign ces_lead_seconds = block.settings.delivery_days | times: 86400 -%}
      {%- assign ces_ship_date = 'now' | date: '%s' | plus: ces_lead_seconds | date: block.settings.date_format -%}
      <div class="ces-main-product__estimate ces-bundle__estimate ces-bundle__estimate--{{ block.settings.ship_position | default: 'above' }}">
        {%- if block.settings.delivery_text != blank -%}
          <span class="ces-main-product__estimate-item">
            {%- if block.settings.delivery_icon != blank -%}
              <span class="ces-main-product__estimate-glyph" aria-hidden="true">{{- block.settings.delivery_icon -}}</span>
            {%- endif -%}
            <span>{{ block.settings.delivery_text }} <strong>{{ ces_ship_date }}</strong></span>
          </span>
        {%- endif -%}
        {%- if block.settings.origin_text != blank -%}
          <span class="ces-main-product__estimate-item ces-main-product__estimate-item--end">
            {%- if block.settings.origin_icon != blank -%}
              <span class="ces-main-product__estimate-glyph" aria-hidden="true">{{- block.settings.origin_icon -}}</span>
            {%- endif -%}
            <span>{{ block.settings.origin_text }}</span>
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endcapture -%}

  {%- if block.settings.ship_position == 'above' -%}{{ ces_ship_row }}{%- endif -%}

  <button type="button" class="ces-b2__add ces-bundle__add button button--full-width button--primary" data-ces-bundle-add>
    <span class="ces-bundle__add-label" data-ces-bundle-label>{{ block.settings.add_label | default: 'Add to Cart' }}</span>
    <span class="ces-bundle__add-total" data-ces-bundle-total></span>
    <span class="ces-bundle__spinner" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" stroke-opacity="0.3"/><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg></span>
  </button>

  {%- unless block.settings.ship_position == 'above' -%}{{ ces_ship_row }}{%- endunless -%}

  {%- if block.settings.sub_note != blank -%}
    {%- comment -%}
      Lines written as "icon | text" become an icon row ("Refills ship on your
      schedule | Stop anytime"); any other note stays a plain sentence.
    {%- endcomment -%}
    {%- capture ces_refill_span -%}<span data-ces-refill>{{ ces_checked_refill | escape }}</span>{%- endcapture -%}
    {%- if block.settings.sub_note contains '|' -%}
      <ul class="ces-bundle__note ces-b2__note-row" role="list">
        {%- assign ces_note_lines = block.settings.sub_note | newline_to_br | split: '<br />' -%}
        {%- for line in ces_note_lines -%}
          {%- assign nparts = line | split: '|' -%}
          {%- assign ntext = nparts[1] | strip -%}
          {%- if ntext != blank -%}
            <li class="ces-b2__note-item">
              {%- assign nicon = nparts[0] | strip -%}
              {%- if nicon != blank -%}{%- render 'ces-icon', icon: nicon, size: '1.8rem', class: 'ces-b2__note-icon' -%}{%- endif -%}
              <span>{{ ntext | replace: '[refill]', ces_refill_span }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="ces-bundle__note">{{ block.settings.sub_note }}</p>
    {%- endif -%}
  {%- endif -%}

  {%- if block.settings.trust_position == 'below' -%}{{ ces_trust_row }}{%- endif -%}
</ces-bundle>

<script>
  // Free-gift accordion. The bar lives inside the tier's <label>, so the click
  // must not bubble out and re-trigger the radio.
  (function () {
    var root = document.getElementById('ces-bundle');
    if (!root || root.dataset.cesGiftReady) return;
    root.dataset.cesGiftReady = '1';
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-ces-gift-toggle]');
      if (!btn || !root.contains(btn)) return;
      e.preventDefault();
      e.stopPropagation();
      var open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      btn.closest('[data-ces-gift]').classList.toggle('is-open', open);
    });
  })();
</script>
